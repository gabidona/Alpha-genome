acceptor_ref_scores_for_excel['gene_name'] = 'ABCA4'
acceptor_ref_scores_for_excel = acceptor_ref_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']].rename(columns={'raw_score': 'acceptor splice site reference score'})

# Acceptor Alternative Scores
acceptor_alt_scores_for_excel = final_splice_alt_scores_df[final_splice_alt_scores_df['track_name'] == 'acceptor'].copy()
acceptor_alt_scores_for_excel['gene_name'] = 'ABCA4'
acceptor_alt_scores_for_excel = acceptor_alt_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']].rename(columns={'raw_score': 'acceptor splice site alternative score'})

# Donor Reference Scores
donor_ref_scores_for_excel = final_splice_ref_scores_df[final_splice_ref_scores_df['track_name'] == 'donor'].copy()
donor_ref_scores_for_excel['gene_name'] = 'ABCA4'
donor_ref_scores_for_excel = donor_ref_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']].rename(columns={'raw_score': 'donor splice site reference score'})

# Donor Alternative Scores
donor_alt_scores_for_excel = final_splice_alt_scores_df[final_splice_alt_scores_df['track_name'] == 'donor'].copy()
donor_alt_scores_for_excel['gene_name'] = 'ABCA4'
donor_alt_scores_for_excel = donor_alt_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']].rename(columns={'raw_score': 'donor splice site alternative score'})

# --- Prepare RNA-seq data for Excel output ---
rna_seq_ref_scores_for_excel = final_rna_seq_ref_scores_df.copy()
rna_seq_ref_scores_for_excel['gene_name'] = 'ABCA4' # Set gene name to ABCA4
rna_seq_ref_scores_for_excel = rna_seq_ref_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']]

rna_seq_alt_scores_for_excel = final_rna_seq_alt_scores_df.copy()
rna_seq_alt_scores_for_excel['gene_name'] = 'ABCA4' # Set gene name to ABCA4
rna_seq_alt_scores_for_excel = rna_seq_alt_scores_for_excel[['gene_name', 'variant_id', 'raw_score', 'output_type', 'allele_type']]


